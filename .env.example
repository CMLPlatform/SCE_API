# Copy this file to .env (in the repository root) and fill in the values.
# Never commit .env: it is in .gitignore.

# Required outside debug mode. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Set to True only on your own computer, never on a server.
DJANGO_DEBUG=False

# Comma-separated host names the site is served from.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.eu.pythonanywhere.com
# Full origins (with https://) allowed to send forms, for HTTPS deployments.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional
# DJANGO_LOG_LEVEL=INFO
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_ANON_THROTTLE=30/minute
# DJANGO_MEDIA_ROOT=/path/to/uploads

# PostgreSQL (leave POSTGRES_DB empty to use SQLite)
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
